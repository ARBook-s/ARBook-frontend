        <mxCell id="tbl-users" value="&lt;table border=&quot;1&quot; cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:11px;width:100%;font-family:Segoe UI,sans-serif&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;background:#5B9BD5;color:#fff;text-align:center;font-weight:bold;border:1px solid #2F528F;padding:6px&quot;&gt;Users&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#D6E3F4;width:34px;text-align:center;border:1px solid #999;font-weight:bold&quot;&gt;PK&lt;/td&gt;&lt;td style=&quot;background:#fff;border:1px solid #999;padding:4px&quot;&gt;&lt;b&gt;Id&lt;/b&gt; · integer · identity&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#D6E3F4;border:1px solid #999&quot;&gt;&amp;nbsp;&lt;/td&gt;&lt;td style=&quot;background:#fff;border:1px solid #999;padding:4px&quot;&gt;&lt;b&gt;Username&lt;/b&gt; · varchar(100) · NOT NULL · UNIQUE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#D6E3F4;border:1px solid #999&quot;&gt;&amp;nbsp;&lt;/td&gt;&lt;td style=&quot;background:#fff;border:1px solid #999;padding:4px&quot;&gt;&lt;b&gt;PasswordHash&lt;/b&gt; · varchar(500) · NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2F528F;strokeWidth=1;" vertex="1" parent="1">
