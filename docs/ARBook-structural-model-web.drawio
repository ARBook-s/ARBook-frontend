          <mxGeometry x="308" y="180" width="72" height="168" as="geometry" />
        </mxCell>

        <mxCell id="backend" value="&lt;b&gt;Основной проект ARBook API&lt;/b&gt;&lt;br&gt;(ASP.NET Core, Kestrel)&lt;br&gt;&lt;br&gt;• HTTP-конвейер: CORS, аутентификация, авторизация,&lt;br&gt;  middleware статистики&lt;br&gt;• Контроллеры: Auth, Markers, Statistics&lt;br&gt;• Сервисы: маркеры, combined .mind, логирование API&lt;br&gt;• Загрузка / выдача файлов в объектное хранилище&lt;br&gt;&lt;br&gt;&lt;i&gt;Синхронный обмен с Front по HTTPS; брокер сообщений не используется.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="412" y="72" width="420" height="380" as="geometry" />
        </mxCell>

        <mxCell id="content-src" value="Поставка AR-контента&#xa;Загрузка .mind, .glb, аудио&#xa;через админ-интерфейс&#xa;(multipart, без очереди)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="940" y="120" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="no-mq" value="RabbitMQ / очереди&#xa;&lt;i&gt;не применяются&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=10;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="940" y="252" width="200" height="56" as="geometry" />
